DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api

# PostgreSQL (host local o puerto publicado del contenedor db)
DATABASE_URL=postgres://pqr:pqr@localhost:5432/pqr_db

# docker-compose
POSTGRES_DB=pqr_db
POSTGRES_USER=pqr
POSTGRES_PASSWORD=pqr
POSTGRES_PORT=5432
API_PORT=8000
RUN_SEED=True

# CORS (Vite frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# External email notifications (Resend). Empty = log-only fallback.
EMAIL_API_KEY=
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_FROM=PQR Sersocial <onboarding@resend.dev>
NOTIFICATIONS_ENABLED=True
